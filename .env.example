# Binance public endpoints
BINANCE_REST_URL=https://api.binance.com
BINANCE_WS_URL=wss://stream.binance.com:9443/stream

# Paper trading
STARTING_BALANCE=1000

# Market filters
MIN_24H_QUOTE_VOLUME=20000000
MAX_SPREAD_PCT=0.05
MAX_ENTRY_SPREAD_PCT=0.03

# Buy pressure
MIN_BUY_PRESSURE_10S=0.68
MIN_BUY_PRESSURE_30S=0.60

# Order book
MIN_ORDERBOOK_IMBALANCE=0.25

# Volume velocity
MIN_VOLUME_VELOCITY=2.5

# BTC protection
MAX_BTC_MOVE_10S_PCT=0.20

# Anti-chasing
MAX_CHASE_5S_PCT=0.15

# Strategy score
MIN_SCORE=80

# Trade management
STOP_LOSS_PCT=0.18
TAKE_PROFIT_PCT=0.28
MAX_HOLD_SECONDS=20

# Simulated trading costs
FEE_RATE=0.001
SLIPPAGE_BPS=2

# Risk management
RISK_PER_TRADE_PCT=0.10
MAX_POSITION_PCT=20
MAX_OPEN_TRADES=3
DAILY_LOSS_LIMIT_PCT=1

# Dashboard
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8080

# Database
DATABASE_PATH=data/sniper.db
